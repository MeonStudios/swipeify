# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git.

# Client ID of your app on https://developer.spotify.com/dashboard (Settings → Basic Information).
# This is not a secret; Swipeify never needs the Client secret.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Must exactly match a Redirect URI in your Spotify app settings.
# Defaults to <the address you open the app on>/callback.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
